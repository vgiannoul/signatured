# Google Workspace Signature Manager Configuration
#
# These environment variables set default values for CLI flags.
# Command-line flags take precedence over these values.
# Example: --template flag overrides TEMPLATE_PATH

# Path to service account credentials JSON file
CREDENTIALS_PATH=./credentials.json

# Admin user email for domain-wide delegation
IMPERSONATE_USER=admin@example.com

# Path to signature template (supports local files and GCS URLs)
# Examples:
#   Local: ./templates/signatured.md
#   GCS:   gs://my-bucket/templates/signatured.md
#   HTTPS: https://storage.googleapis.com/my-bucket/templates/signatured.md
TEMPLATE_PATH=./templates/signatured.md

# Test user for dry-run testing
TEST_USER=testuser@example.com

# Enable verbose logging (true/false)
VERBOSE=false

# Optional: user emails to skip on "apply" (comma-separated), e.g. shared
# mailboxes or service accounts. Same effect as passing --exclude.
EXCLUDE_USERS=noreply@example.com,shared-inbox@example.com

# Company-wide signature configuration
# Set these values for templates that include company branding (e.g., templates/example.html)
COMPANY_WEBSITE=https://example.com
COMPANY_LOGO=https://example.com/logo.png
COMPANY_PHONE=+1-555-0100
COMPANY_ADDRESS=123 Main St, City, State 12345

# Optional: labels for {{phoneLabel}}, shown next to a user's work phone.
# Both default to empty (no effect) unless a template uses {{phoneLabel}}.
# COMPANY_PHONE_LABEL is used normally; COMPANY_INTERNAL_PHONE_LABEL is used
# instead when the work phone is a "Custom" type in Workspace whose custom
# type mentions "internal" (e.g. an office extension).
COMPANY_PHONE_LABEL=T
COMPANY_INTERNAL_PHONE_LABEL=Ext.
